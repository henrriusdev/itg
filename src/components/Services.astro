	},
	{
		title: "Hardware y Servidores",
		description: "Suministro de servidores de alto rendimiento, workstations y laptops corporativas con garantía oficial y especificaciones adaptadas.",
		keyBenefit: "Acceso a hardware empresarial de marcas líderes con soporte confiable.",
		paymentUrl: "https://wa.me/584243055675?text=Hola%20ITG,%20quiero%20pagar%20el%20servicio%20de%20Hardware%20y%20Servidores",
		image: "https://images.unsplash.com/photo-1591799265444-d66432b91588?q=80&w=2069&auto=format&fit=crop",
		icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>`
	},
	{
		title: "Sistemas UPS",
		description: "Cálculo, suministro e instalación de soluciones UPS. Aseguramos energía limpia y tiempo de respaldo para cierre seguro.",
		keyBenefit: "Continuidad operativa y protección contra daños eléctricos.",
		paymentUrl: "https://wa.me/584243055675?text=Hola%20ITG,%20quiero%20pagar%20el%20servicio%20de%20Sistemas%20UPS",
		image: "https://images.unsplash.com/photo-1620714223084-8fcacc6dfd8d?q=80&w=2071&auto=format&fit=crop",
		icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`
	}
];
---

<section id="servicios" class="py-20 bg-gray-50">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<!-- Header -->
		<div class="text-center mb-16">
			<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
				Soluciones Integrales para la Era Digital
			</h2>
			<p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
				Desde el núcleo de su infraestructura hasta la gestión estratégica de su negocio.
			</p>
		</div>
		
		<!-- Services Grid -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{services.map((service) => (
				<article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 group border border-gray-100">
					<!-- Image -->
					<div class="h-48 overflow-hidden relative">
						<img 
							src={service.image} 
							alt={service.title}
							class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							loading="lazy"
						/>
						<div class="absolute inset-0 bg-linear-to-t from-black/30 to-transparent"></div>
						
						<!-- Icon Badge -->
						<div class="absolute bottom-4 left-4 w-12 h-12 bg-white rounded-xl shadow-lg flex items-center justify-center text-blue-600">
							<Fragment set:html={service.icon} />
						</div>
					</div>
					
					<!-- Content -->
					<div class="p-6">
						<h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-blue-700 transition-colors">
							{service.title}
						</h3>
						<p class="text-gray-600 text-sm mb-4 leading-relaxed">
							{service.description}
						</p>
						
						<!-- Key Benefit -->
						<div class="flex items-start gap-2 pt-4 border-t border-gray-100">
							<svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							<span class="text-sm text-gray-700 font-medium">{service.keyBenefit}</span>
						</div>

						<div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
							<a
								href={service.paymentUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center gap-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-semibold py-2.5 px-4 rounded-lg transition-colors"
							>
								Pagar Servicio
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
								</svg>
							</a>
							<a
								href="#contacto"
								class="inline-flex items-center justify-center text-sm font-semibold py-2.5 px-4 rounded-lg border border-gray-300 text-gray-700 hover:border-gray-400 hover:text-gray-900 transition-colors"
							>
								Cotizar antes de pagar
							</a>
						</div>
					</div>
				</article>
			))}
		</div>
		
		<!-- CTA Section -->
		<div class="mt-16 text-center">
			<div class="inline-flex flex-col sm:flex-row gap-4 items-center">
				<a 
					href="#contacto"
					class="inline-flex items-center gap-2 bg-blue-900 hover:bg-blue-800 text-white font-semibold py-4 px-8 rounded-lg text-lg transition-all duration-300 shadow-lg hover:shadow-xl"
				>
					Solicitar Consultoría
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
					</svg>
				</a>
				<span class="text-gray-500 text-sm">Sin compromiso · Respuesta en 24h</span>
			</div>
		</div>
		
	</div>
</section>
