		keyBenefit: "Visión estratégica y optimización del retorno de inversión (ROI).",
		paymentUrl: "https://wa.me/584243055675?text=Hola%20ITG,%20quiero%20pagar%20el%20servicio%20de%20Asesor%C3%ADa%20Tecnol%C3%B3gica",
		image: "https://images.unsplash.com/photo-1553877522-43269d4ea984?q=80&w=2070&auto=format&fit=crop",
		icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>`
	},
	{
		title: "Especialistas en Telecomunicaciones",
		description: "Infraestructura de conectividad: cableado estructurado, redes inalámbricas de alta densidad, seguridad perimetral y VPNs.",
		keyBenefit: "Conectividad robusta y segura que elimina cuellos de botella.",
		paymentUrl: "https://wa.me/584243055675?text=Hola%20ITG,%20quiero%20pagar%20el%20servicio%20de%20Telecomunicaciones",
		image: "https://images.unsplash.com/photo-1544197150-b99a580bb7a8?q=80&w=2070&auto=format&fit=crop",
		icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path></svg>`
	},
	{
		title: "Data Centers",
		description: "Diseño y construcción bajo estándares internacionales. Saneamiento de cuartos de servidores y ordenamiento de cableado para reducir riesgos.",
		keyBenefit: "Protección física de datos críticos y reducción de riesgos operativos.",
		paymentUrl: "https://wa.me/584243055675?text=Hola%20ITG,%20quiero%20pagar%20el%20servicio%20de%20Data%20Centers",
		image: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=2034&auto=format&fit=crop",
